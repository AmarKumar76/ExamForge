# Environment Configuration Placeholder
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_URI_TEST=mongodb+srv://<username>:<password>@<cluster>/<test_database>

# Authentication & JWT Secrets
JWT_SECRET=your_jwt_access_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRATION=7d

# Cache & Redis Configuration
REDIS_URL=redis://localhost:6379

# Cloud Object Storage (AWS S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AI & Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite

# Primary Super Admin Account Credentials
SUPERADMIN_EMAIL=amar766730@gmail.com
SUPERADMIN_PASSWORD=Amar@123

# Gmail SMTP Email Dispatcher Configuration
# 1. Enable 2-Step Verification in Google Account -> Security
# 2. Generate a 16-character App Password under Google Account -> Security -> App passwords
# 3. Paste the 16-character code into SMTP_PASSWORD below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=amar766730@gmail.com
SMTP_PASSWORD=your_16_character_gmail_app_password
SMTP_FROM="ExamForge System <amar766730@gmail.com>"

